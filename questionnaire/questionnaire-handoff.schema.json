{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trip-companion.local/schemas/questionnaire-handoff-v2.json",
  "title": "Trip Companion questionnaire handoff",
  "type": "object",
  "required": ["schemaVersion", "generatedAt", "trip", "travelers", "budget", "style", "interests", "food", "priorities", "planning", "privacy"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "generatedAt": { "type": "string" },
    "trip": {
      "type": "object",
      "required": ["workingTitle", "destinations", "startDate", "endDate", "dateFlexibility", "origin"],
      "properties": {
        "workingTitle": { "type": "string" },
        "destinations": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "startDate": { "type": "string", "format": "date" },
        "endDate": { "type": "string", "format": "date" },
        "dateFlexibility": { "type": "string" },
        "origin": { "type": "string" }
      },
      "additionalProperties": false
    },
    "travelers": {
      "type": "object",
      "required": ["count", "groupType", "agesOrLifeStages", "accessibilityNeeds", "preferenceComparison"],
      "properties": {
        "count": { "type": "integer", "minimum": 1, "maximum": 20 },
        "groupType": { "type": "string" },
        "agesOrLifeStages": { "type": "array", "items": { "type": "string" } },
        "accessibilityNeeds": { "type": "array", "items": { "type": "string" } },
        "preferenceComparison": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["travelerLabel", "priorities"],
            "properties": {
              "travelerLabel": { "enum": ["Traveler 1", "Traveler 2"] },
              "priorities": { "type": "array", "items": { "type": "string" } }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "budget": { "type": "object" },
    "style": { "type": "object" },
    "interests": { "type": "object" },
    "food": { "type": "object" },
    "priorities": { "type": "object" },
    "planning": { "type": "object" },
    "privacy": {
      "type": "object",
      "required": ["publicGuideAllowed", "sensitiveFieldsProvided", "travelerSpecificVisibilityRules"],
      "properties": {
        "publicGuideAllowed": { "type": "boolean" },
        "sensitiveFieldsProvided": { "const": false },
        "travelerSpecificVisibilityRules": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
