{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trip-companion.local/schemas/trip-data-v2.json",
  "title": "Trip Companion structured trip data",
  "type": "object",
  "required": ["schemaVersion", "trip", "days"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "trip": {
      "type": "object",
      "required": ["id", "title", "dateLabel", "travelerLabel", "summary"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "title": { "type": "string", "minLength": 1 },
        "dateLabel": { "type": "string", "minLength": 1 },
        "travelerLabel": { "type": "string", "minLength": 1 },
        "summary": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": true
    },
    "days": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "date", "title", "activities"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "date": { "type": "string", "format": "date" },
          "title": { "type": "string", "minLength": 1 },
          "summary": { "type": "string" },
          "audiences": { "$ref": "#/$defs/audiences" },
          "activities": {
            "type": "array",
            "items": { "$ref": "#/$defs/activity" }
          },
          "reservations": {
            "type": "array",
            "items": { "$ref": "#/$defs/reservation" }
          },
          "notes": {
            "type": "array",
            "items": { "$ref": "#/$defs/note" }
          }
        },
        "additionalProperties": true
      }
    }
  },
  "$defs": {
    "audiences": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-z0-9-]+$" },
      "minItems": 1,
      "uniqueItems": true
    },
    "link": {
      "type": "object",
      "required": ["label", "url"],
      "properties": {
        "label": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "pattern": "^https://" }
      },
      "additionalProperties": false
    },
    "activity": {
      "type": "object",
      "required": ["id", "timeLabel", "title", "description"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "timeLabel": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "tags": { "type": "array", "items": { "type": "string" } },
        "links": { "type": "array", "items": { "$ref": "#/$defs/link" } },
        "audiences": { "$ref": "#/$defs/audiences" }
      },
      "additionalProperties": true
    },
    "reservation": {
      "type": "object",
      "required": ["id", "title", "status", "publicDetail"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "title": { "type": "string", "minLength": 1 },
        "status": { "enum": ["considering", "recommended", "approved", "reservation-needed", "booked", "rejected", "backup"] },
        "publicDetail": { "type": "string" },
        "links": { "type": "array", "items": { "$ref": "#/$defs/link" } },
        "audiences": { "$ref": "#/$defs/audiences" }
      },
      "additionalProperties": true
    },
    "note": {
      "type": "object",
      "required": ["id", "text"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "text": { "type": "string", "minLength": 1 },
        "audiences": { "$ref": "#/$defs/audiences" }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
